# Copy to .env and fill in your own values. Never commit .env.
APPLICATION_URL=http://localhost:5173
ADMINISTRATION_URL=http://localhost:5174

# Base64-encoded key of at least 512 bits, e.g. `openssl rand -base64 64`
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local default: the mailpit service of docker-compose.yml (inbox on http://localhost:8025).
# For real e-mail use your provider, e.g. SMTP_HOST=ssl0.ovh.net, SMTP_PORT=465, SMTP_PROTOCOL=smtps,
# SMTP_AUTH=true, SMTP_STARTTLS=true, with its username and password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_PROTOCOL=smtp
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=team@example.com
SMTP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
